{
  "name": "obsidian-ghost-fade-focus",
  "version": "1.0.0",
  "description": "Ghost Fade Focus plugin for Obsidian that ignores empty lines when calculating focus",
  "main": "main.js",
  "scripts": {
    "dev": "rollup --config rollup.config.js -w",
    "build": "rollup --config rollup.config.js --environment BUILD:production",
    "test": "NODE_OPTIONS=--no-warnings jest"
  },
  "scriptNotes": {
    "test": "NODE_OPTIONS=--no-warnings suppresses deprecation warnings from dependencies, only affects testing environment"
  },
  "keywords": [
    "focus",
    "ghost",
    "obsidian"
  ],
  "author": "Sami Korpela",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/skipadu/obsidian-ghost-fade-focus.git"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^22.0.2",
    "@rollup/plugin-node-resolve": "^14.1.0",
    "@rollup/plugin-typescript": "^8.5.0",
    "@types/jest": "^29.5.12",
    "@types/node": "^18.7.18",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "obsidian": "^0.16.3",
    "rollup": "^2.79.0",
    "ts-jest": "^29.1.2",
    "tslib": "^2.4.0",
    "typescript": "^5.0.0"
  },
  "dependencyNotes": {
    "jest-environment-jsdom": "Provides browser-like environment for tests",
    "ts-jest": "TypeScript support for Jest"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "moduleNameMapper": {
      "obsidian": "<rootDir>/__mocks__/obsidian.ts",
      "@codemirror/(.*)": "<rootDir>/__mocks__/codemirror.ts"
    },
    "testMatch": [
      "**/src/test/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": ["ts-jest", {
        "isolatedModules": true
      }]
    }
  },
  "jestNotes": {
    "preset": "TypeScript configuration for Jest",
    "testEnvironment": "Uses jsdom to simulate DOM environment for testing",
    "moduleNameMapper": "Maps import statements to mock implementations",
    "testMatch": "Pattern to find test files",
    "collectCoverageFrom": "Files to include in coverage reports",
    "transform.isolatedModules": "Improves performance by disabling type checking during tests"
  }
}
