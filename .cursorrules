{
    "rules": {
        "project_configuration": {
            "name": "malareparam",
            "priorities": [
                {
                    "source": ".notes/",
                    "weight": 1.0
                }
            ],
            "initialization": {
                "description": "Starting point for each interaction",
                "steps": [
                    "ALWAYS read `.notes/project_overview.md` and `.notes/task_list.md`"
                ]
            }
        },

        "session_management": {
            "description": "Rules for managing user interaction sessions",
            "session_start": {
                "description": "How to begin each interaction",
                "format": "Current status: {brief_status}.\nNext priority: {next_task}.\nWhy: {why_this_task}.\n[Confidence: {confidence}%]"
            },
            "session_end": {
                "description": "How to conclude each interaction",
                "actions": [
                    "Update implementation_log.md with any accepted code changes",
                    "Summarize progress and open questions"
                ]
            },
            "context_handling": {
                "description": "How to manage context during interactions",
                "priority_order": "1) current task details, 2) relevant code structure, 3) recent changes"
            }
        },

        "work_modes": {
            "meta_cognitive": {
                "description": "Self-monitoring rules that apply across all modes",
                "rules": [
                    "MUST validate all assumptions with explicit evidence before finalizing any response",
                    "MUST explicitly list information gaps when uncertainty exists",
                    "MUST downgrade confidence by at least 15% for each missing critical piece of information",
                    "MUST NOT exceed 95% confidence without visual evidence for visual problems",
                    "MUST use the confidence checklist before stating any confidence level",
                    "When handling complex problems, explain high-level reasoning before details",
                    "Track confidence explicitly with a percentage value",
                    "Use structured reasoning: 0) state goal and relate to project overview, 1) state problem, 2) identify constraints, 3) evaluate options, 4) recommend solution"
                ],
                "confidence_checklist": [
                    "Do I have direct visual evidence of the issue? (-20% if no)",
                    "Do I have debug logs or console output? (-15% if no)",
                    "Have I seen the actual code where the issue occurs? (-25% if no)",
                    "Have I considered at least 3 alternative explanations? (-10% if no)",
                    "Have I verified my solution against edge cases? (-15% if no)"
                ]
            },
            "plan": {
                "description": "Focus on information gathering, problem understanding, and solution architecture",
                "is_default": true,
                "read_only": true,
                "keyword": "plan",
                "rules": [
                    "Create a MECE task breakdown with clear, atomic subtasks",
                    "Continue investigating until high confidence is reached",
                    "MUST list specific evidence needed to increase confidence",
                    "MUST NOT transition to debug/act mode if confidence < 85%",
                    "MUST explicitly state what information is missing",
                    "Verify alignment with top priority task in task_list.md",
                    "End with \"Confidence: X%. Would you like me to implement this plan?\"",
                    "If confidence < 85%, MUST list 3-5 specific questions that would increase confidence"
                ],
                "transition": {
                    "to_debug": "ONLY transition to Debug mode when confidence >= 85% AND you have explicit evidence supporting your hypothesis.",
                    "to_edit": "ONLY transition to Edit mode when confidence >= 90% AND you have verified your solution against potential edge cases."
                }
            },
            "debug": {
                "description": "Focus on identifying and fixing issues in existing code",
                "read_write": true,
                "keyword": "debug",
                "confidence_required": 90,
                "rules": [
                    "Start with a minimal reproducible example",
                    "State debugging hypothesis explicitly before implementing fixes",
                    "Use root cause analysis: trace errors to their source rather than fixing symptoms",
                    "Test solution against multiple cases",
                    "Return to plan mode if new questions arise or confidence drops below 70%"
                ],
                "error_recovery": "If the fix doesn't resolve the issue: 1) document the attempt, 2) revert to plan mode, 3) create alternative hypotheses"
            },
            "act": {
                "description": "Focus on implementing new features or making planned changes",
                "read_write": true,
                "keyword": "act",
                "confidence_required": 100,
                "rules": [
                    "Always state explicitly what you are going to do before you do it",
                    "Begin with a failing test that validates the feature requirements",
                    "Break implementation into small, verifiable steps",
                    "Consider edge cases explicitly before completing implementation",
                    "Return to plan mode if requirements are unclear or new questions arise"
                ],
                "error_recovery": "If implementation is blocked: 1) document specific obstacles, 2) return to plan mode, 3) suggest alternative approaches"
            }
        },

        "documentation": {
            "general_principles": {
                "description": "Rules that apply to all documentation",
                "rules": [
                    "ALWAYS append new content to the START of documentation files, not the end",
                    "Use clear, concise language focusing on key information",
                    "Include timestamps for all entries"
                ]
            },
            "document_types": {
                "implementation_log": {
                    "purpose": "Track individual code changes",
                    "update_frequency": "After EACH accepted code change",
                    "template": "- {date} {time}: {action} - {concise_summary} [File: {file_link}]"
                },
                "decisions": {
                    "purpose": "Record significant technical decisions with rationale",
                    "update_frequency": "When making architectural changes or significant implementation decisions",
                    "template": "## {date}: {decision_title}\n\n### Decision\n{decision}\n\n### Rationale\n{rationale}\n\n### Implementation Details\n{details}\n\n### Consequences\n{consequences}"
                },
                "session_summary": {
                    "purpose": "Summarize major interactions and progress",
                    "update_frequency": "At the end of each major interaction or coding session",
                    "template": "## {date}: {session_title}\n\n### Accomplishments\n- {accomplishment1}\n\n### Challenges\n- {challenge1}\n\n### Next Steps\n- {next_step1}"
                },
                "task_list": {
                    "purpose": "Track project tasks and their status",
                    "update_frequency": "When adding new tasks or completing existing ones",
                    "template": "- [ ] {task_description} (Added: {date})"
                },
                "status_updates": {
                    "purpose": "Provide periodic project status summaries",
                    "update_frequency": "Weekly or at major milestones",
                    "template": "## Week of {date} (Update {number})\n\n### Current Status\n{status}\n\n### Key Accomplishments\n- {accomplishment1}\n\n### Challenges & Solutions\n- {challenge1}\n\n### Next Steps\n- {next_step1}"
                },
                "project_overview": {
                    "purpose": "Provide high-level project description",
                    "update_frequency": "When significant architectural changes occur",
                    "sections": ["Description", "Core Functionality", "Technical Architecture", "Dependencies"]
                }
            }
        },

        "code_standards": {
            "description": "Unified standards for high-quality, readable code",
            "structure": {
                "description": "Rules for code organization and structure",
                "rules": [
                    "Function Shape: Limit functions to 15-20 lines doing one thing well with a clear purpose",
                    "Nesting: Maximum 2-3 levels of indentation - extract to helper functions when deeper",
                    "Abstraction: Maintain consistent abstraction level within a function or code block",
                    "Organization: Group related functions together, ordered from high-level to low-level implementation details"
                ]
            },
            "style": {
                "description": "Rules for code readability and style",
                "rules": [
                    "Naming: Use intention-revealing names that explain purpose, not implementation",
                    "Cognitive Load: Keep variable lifespans short and visible within their usage context",
                    "Documentation: Include meaningful docstrings explaining 'why' not 'what' for non-obvious code",
                    "Visual Clarity: Use consistent spacing and formatting to create visual patterns"
                ]
            },
            "patterns": {
                "description": "Rules for implementation patterns and approaches",
                "rules": [
                    "Simplicity: Prefer explicit, straightforward approaches over clever optimizations",
                    "Refactoring Triggers: Consider refactoring when nesting exceeds 3 levels, function exceeds 20 lines, or variable usage spans many screens",
                    "Quality Check: Ask 'Could a new developer understand this in under 30 seconds?'"
                ]
            },
            "testing": {
                "description": "Rules for effective test implementation",
                "rules": [
                    "Direct Implementation Testing: ALWAYS test actual implementation code, not mocks or duplicates of functions",
                    "Function Exports: Make core functions exportable to facilitate direct testing",
                    "Test Design: Structure tests to import and test real implementations directly",
                    "No Logic Duplication: Never duplicate implementation logic in test files",
                    "Test Boundary: Tests should verify behavior, not implementation details",
                    "Visibility: Keep test helper functions in separate files from implementation code",
                    "Testability: Design code with testability in mind, using dependency injection where appropriate"
                ]
            },
            "language_specific": {
                "jax": {
                    "description": "JAX-specific programming rules",
                    "rules": [
                        "Never use dynamic Python slicing (arr[start:stop]) where start/stop depend on non-static function inputs",
                        "Use vmap instead of manually writing out loops",
                        "Ensure you're using the latest version of JAX"
                    ]
                }
            }
        },

        "task_management": {
            "description": "Rules for managing tasks and tracking progress",
            "rules": [
                "NEVER mark a parent task as completed [x] if it has any uncompleted subtasks [ ]",
                "Only mark a task as completed when ALL its subtasks are completed",
                "When creating task hierarchies, ensure parent tasks accurately reflect the status of all subtasks",
                "Maintain a 'blocking issues' section in task_list.md",
                "When updating task status, always check parent-child relationships"
            ]
        }
    }
}